{
  "manifest_version": 3,
  "name": "Feedless",
  "version": "1.0.0",
  "description": "Block algorithmic recommendations on social media to help you stay focused.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Feedless"
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://bilibili.com/*",
        "*://*.bilibili.com/*",
        "*://douyin.com/*",
        "*://*.douyin.com/*",
        "*://kuaishou.com/*",
        "*://*.kuaishou.com/*",
        "*://tiktok.com/*",
        "*://*.tiktok.com/*",
        "*://twitch.tv/*",
        "*://*.twitch.tv/*",
        "*://xiaohongshu.com/*",
        "*://*.xiaohongshu.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://weibo.com/*",
        "*://*.weibo.com/*",
        "*://zhihu.com/*",
        "*://*.zhihu.com/*",
        "*://instagram.com/*",
        "*://*.instagram.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*",
        "*://threads.net/*",
        "*://*.threads.net/*",
        "*://reddit.com/*",
        "*://*.reddit.com/*",
        "*://quora.com/*",
        "*://*.quora.com/*",
        "*://taobao.com/*",
        "*://*.taobao.com/*",
        "*://jd.com/*",
        "*://*.jd.com/*",
        "*://baidu.com/*",
        "*://*.baidu.com/*"
      ],
      "js": ["src/sites.js", "src/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["src/x-fetch-blocker.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
