{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.3.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://bilibili.com/*",
    "*://*.bilibili.com/*",
    "*://douyin.com/*",
    "*://*.douyin.com/*",
    "*://tiktok.com/*",
    "*://*.tiktok.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://xiaohongshu.com/*",
    "*://*.xiaohongshu.com/*",
    "*://weibo.com/*",
    "*://*.weibo.com/*",
    "*://zhihu.com/*",
    "*://*.zhihu.com/*",
    "*://taobao.com/*",
    "*://*.taobao.com/*",
    "*://jd.com/*",
    "*://*.jd.com/*",
    "*://baidu.com/*",
    "*://*.baidu.com/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Feedless"
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://bilibili.com/*",
        "*://*.bilibili.com/*",
        "*://douyin.com/*",
        "*://*.douyin.com/*",
        "*://tiktok.com/*",
        "*://*.tiktok.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://xiaohongshu.com/*",
        "*://*.xiaohongshu.com/*",
        "*://weibo.com/*",
        "*://*.weibo.com/*",
        "*://zhihu.com/*",
        "*://*.zhihu.com/*",
        "*://taobao.com/*",
        "*://*.taobao.com/*",
        "*://jd.com/*",
        "*://*.jd.com/*",
        "*://baidu.com/*",
        "*://*.baidu.com/*"
      ],
      "js": [
        "src/sites.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "src/x-fetch-blocker.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/app/icon16.png",
    "48": "icons/app/icon48.png",
    "128": "icons/app/icon128.png"
  }
}
